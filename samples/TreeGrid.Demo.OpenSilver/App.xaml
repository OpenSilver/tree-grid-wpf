<Application x:Class="TreeGrid.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wt="http://opensilver.net/themes/wpf"
             StartupUri="MainWindow.xaml">
    <Application.Theme>
        <!-- Gives the built-in controls their WPF look, as in the WPF demo. -->
        <wt:WpfTheme />
    </Application.Theme>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Merged at application scope so the window chrome can use the same
                    keys as the grid. The theme toggle swaps this one entry.
                -->
                <ResourceDictionary Source="/TreeGrid.OpenSilver;component/Themes/FluentLight.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
