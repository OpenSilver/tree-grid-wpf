<Application x:Class="TreeGrid.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mt="http://opensilver.net/themes/modern"
             StartupUri="MainWindow.xaml">
    <Application.Theme>
        <!-- Styles the built-in controls; the theme toggle switches its palette with the grid's. -->
        <mt:ModernTheme CurrentPalette="Light" />
    </Application.Theme>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Merged at application scope so the window chrome can use the same
                    keys as the grid. The theme toggle swaps this one entry.
                -->
                <ResourceDictionary Source="/TreeGrid.OpenSilver;component/Themes/FluentLight.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
