<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <Import Project="..\..\OpenSilver.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OpenSilverType>7</OpenSilverType>
    <PublishTrimmed>true</PublishTrimmed>
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetCoreWebAssemblyVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(AspNetCoreWebAssemblyVersion)" PrivateAssets="all" />
    <PackageReference Include="OpenSilver.WebAssembly" Version="$(OpenSilverVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TreeGrid.Demo.OpenSilver\TreeGrid.Demo.OpenSilver.csproj" />
  </ItemGroup>

</Project>
