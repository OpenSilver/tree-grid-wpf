<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Preview builds of OpenSilver and its companion packages, used by TreeGrid.OpenSilver.sln -->
    <add key="MyGet OpenSilver" value="https://www.myget.org/F/opensilver/api/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="OpenSilver*" />
    </packageSource>
    <packageSource key="MyGet OpenSilver">
      <package pattern="OpenSilver*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
